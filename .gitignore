# macOS Finder droppings, everywhere in the tree
.DS_Store

logs/*
!logs/.gitkeep

# logs/cee-exporter must exist in a fresh checkout: the cee-exporter image
# runs as uid 65532, and a directory Docker auto-creates for the bind mount
# is root-owned 0755, so the writer's open() fails with EACCES and the
# container exits 1. Re-including the directory needs both lines below —
# git does not descend into a directory excluded by "logs/*", so the
# negation on the .gitkeep alone would never be reached.
!logs/cee-exporter/
logs/cee-exporter/*
!logs/cee-exporter/.gitkeep

# test stack: pstcli creds/certs, local env overrides
state/*
!state/.gitkeep
.env

# Dell vendor artefacts. Untracked as of 2026-08-22: they are Dell's to
# distribute, they are available only through Dell's authenticated support
# portal, and nothing in this repo builds them. Fetch them into bin/ yourself
# — see bin/README.md for what each path must be called and why the names
# matter. bin/README.md itself stays tracked, which is what keeps the
# directory present in a fresh clone.
bin/*.rpm
bin/*.exe
bin/*.iso

# ansible: real inventory and vars hold site addresses
ansible/inventory/hosts.yml
ansible/group_vars/all.yml
ansible/group_vars/cee_linux.yml
ansible/group_vars/cee_windows.yml
