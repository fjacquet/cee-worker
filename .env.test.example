# Copy to .env and adjust, or export in your shell.
#   cp .env.test.example .env

# GHCR namespace all images are published under.
GHCR_OWNER=fjacquet

# pstore_exporter image tag (defaults to :latest).
PSTORE_TAG=latest

# PowerStore array pstore_exporter connects to.
PSTORE1_HOSTNAME=10.0.0.1
PSTORE1_USERNAME=admin
PSTORE1_PASSWORD=
PSTORE1_SKIP_CERTIFICATE=false
